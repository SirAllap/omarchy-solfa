#!/usr/bin/python3
"""solfa — command line for Solfa (keybindings, scripts, debugging).

    solfa toggle | open | close        the panel (through the shell)
    solfa play-pause | next | prev     playback
    solfa like                         like the current song (again: remove the like)
    solfa volume +5 | -5 | 40          volume, relative or absolute
    solfa status                       one line: engine, account, song
    solfa quit                         close the engine (also when the bridge is gone)
    solfa call OP [JSON]               any bridge operation, raw reply
    solfa events                       follow the bridge's events (Ctrl+C to stop)
"""
import json
import os
import pathlib
import re
import signal
import socket
import subprocess
import sys
import time

PLUGIN_ID = "io.github.sirallap.solfa"

# A minimal, explicit environment for every child process this CLI spawns: an
# allow-list, never this process's own full environment. PATH is always fixed,
# never inherited (a maintainer rejection: programs found through PATH).
ENV_ALLOW_EXACT = {
    "HOME", "USER", "LOGNAME", "LANG",
    "XDG_RUNTIME_DIR", "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE",
    "WAYLAND_DISPLAY", "DISPLAY", "DBUS_SESSION_BUS_ADDRESS",
    "HYPRLAND_INSTANCE_SIGNATURE", "XCURSOR_THEME", "XCURSOR_SIZE",
}
CHILD_PATH = "/usr/bin:/bin"


def child_env(extra=None):
    env = {"PATH": CHILD_PATH}
    for k, v in os.environ.items():
        if k in ENV_ALLOW_EXACT or k.startswith("LC_") or (k.startswith("XDG_") and k.endswith("_HOME")):
            env[k] = v
    if extra:
        env.update(extra)
    return env


RUNTIME_DIR = pathlib.Path(os.environ.get("SOLFA_RUNTIME_DIR") or
                           pathlib.Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / PLUGIN_ID)
SOCKET_PATH = RUNTIME_DIR / "bridge.sock"
PROFILE_DIR = pathlib.Path(os.environ.get("SOLFA_PROFILE_DIR") or
                           pathlib.Path(os.environ.get("XDG_DATA_HOME") or pathlib.Path.home() / ".local/share") / PLUGIN_ID / "engine")


def engine_pid():
    """The engine's browser pid from its profile lock, checked against /proc."""
    try:
        host, _, pid = os.readlink(PROFILE_DIR / "SingletonLock").rpartition("-")
        cmd = pathlib.Path(f"/proc/{pid}/cmdline").read_bytes()
    except (OSError, ValueError):
        return 0
    want = re.escape(("--user-data-dir=" + str(PROFILE_DIR)).encode())
    if host != socket.gethostname() or not re.search(rb"(^|[\s\0])" + want + rb"([\s\0]|$)", cmd):
        return 0
    return int(pid)


def quit_engine():
    """Close the engine through the bridge; without a bridge, by its checked pid."""
    try:
        b = Bridge(exit_if_down=False, timeout=8)
        if b.sock:
            b.call("engine.stop")
            return 0
    except OSError:
        pass
    pid = engine_pid()
    if not pid:
        return 0
    os.kill(pid, signal.SIGTERM)
    for _ in range(50):
        if not engine_pid():
            return 0
        time.sleep(0.1)
    print("solfa: the engine did not close", file=sys.stderr)
    return 1


class Bridge:
    def __init__(self, timeout=20, exit_if_down=True):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(timeout)
        try:
            self.sock.connect(str(SOCKET_PATH))
        except OSError:
            self.sock.close()
            self.sock = None
            if exit_if_down:
                sys.exit("solfa: the bridge is not running (is the plugin enabled?)")
        self.buf = b""
        self.next_id = 0

    def lines(self):
        while True:
            while b"\n" in self.buf:
                line, self.buf = self.buf.split(b"\n", 1)
                yield json.loads(line)
            chunk = self.sock.recv(65536)
            if not chunk:
                return
            self.buf += chunk

    def call(self, op, args=None):
        self.next_id += 1
        rid = self.next_id
        self.sock.sendall((json.dumps({"id": rid, "op": op, "args": args or {}}) + "\n").encode())
        for msg in self.lines():
            if msg.get("id") == rid:
                return msg
        sys.exit("solfa: the bridge closed the connection")


QS = "/usr/bin/qs"


def shell_ipc(method):
    if not os.access(QS, os.X_OK):
        print("solfa: " + QS + " not found", file=sys.stderr)
        return 1
    cmd = [QS, "ipc", "-p", os.environ.get("OMARCHY_PATH", "/usr/share/omarchy") + "/shell", "call", PLUGIN_ID, method]
    return subprocess.run(cmd, stdout=subprocess.DEVNULL, env=child_env()).returncode


def ok(reply):
    if not reply.get("ok"):
        error, message = reply.get("error", "error"), reply.get("message", "")
        sys.exit("solfa: " + error + (": " + message if message and message != error else ""))
    return reply.get("data")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd in ("toggle", "open", "close"):
        return shell_ipc(cmd)
    if cmd == "quit":
        return quit_engine()
    b = Bridge()
    if cmd == "play-pause":
        ok(b.call("transport", {"action": "toggle"}))
    elif cmd == "next":
        ok(b.call("transport", {"action": "next"}))
    elif cmd in ("prev", "previous"):
        ok(b.call("transport", {"action": "previous"}))
    elif cmd == "like":
        player = ok(b.call("state")).get("player") or {}
        if not player.get("videoId"):
            sys.exit("solfa: nothing is playing")
        status = "INDIFFERENT" if player.get("like") == "LIKE" else "LIKE"
        ok(b.call("like", {"videoId": player["videoId"], "status": status}))
    elif cmd == "volume" and rest:
        value = rest[0]
        current = (ok(b.call("state")).get("player") or {}).get("volume", 100)
        level = current + int(value) if value[0] in "+-" else int(value)
        ok(b.call("volume", {"level": max(0, min(100, level))}))
    elif cmd == "status":
        hello = ok(b.call("hello"))
        eng, acc, pl = hello.get("engine", {}), hello.get("account", {}), hello.get("player", {})
        who = "signed in" if acc.get("signedIn") else "signed out"
        song = (pl.get("title") or "nothing") + (" — " + ", ".join(a.get("name", "") for a in pl.get("artists", [])) if pl.get("artists") else "")
        state = "playing" if pl.get("playing") else "paused"
        print(f"engine {eng.get('status')} · {who} · {state}: {song}")
    elif cmd == "call" and rest:
        args = json.loads(rest[1]) if len(rest) > 1 else {}
        print(json.dumps(b.call(rest[0], args), ensure_ascii=False, indent=1))
    elif cmd == "events":
        b.sock.settimeout(None)
        try:
            for msg in b.lines():
                if "event" in msg:
                    print(json.dumps(msg, ensure_ascii=False)[:400], flush=True)
        except KeyboardInterrupt:
            pass
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
